generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GpaRange {
  GPA_18_20
  GPA_21_24
  GPA_25_27
  GPA_28_30
}

enum EnglishLevel {
  A2
  B1_B2
  C1
  C2_PLUS
}

enum WillingnessToRelocate {
  YES
  MAYBE
  NO
}

enum OpportunityType {
  TIROCINIO
  EXTRACURRICULAR
  EVENT
  FELLOWSHIP
  SUMMER_PROGRAM
  HACKATHON
  COMPETITION
  EXCHANGE
  VOLUNTEERING
  BOOTCAMP
  RESEARCH
}

enum OpportunityFormat {
  ONLINE
  IN_PERSON
  HYBRID
}

enum FieldOfStudy {
  COMPUTER_SCIENCE
  ENGINEERING
  MEDICINE
  LIFE_SCIENCES
  PHYSICAL_SCIENCES
  MATHEMATICS
  ECONOMICS
  BUSINESS
  LAW
  POLITICAL_SCIENCE
  HUMANITIES
  DESIGN
  ARCHITECTURE
  PSYCHOLOGY
  EDUCATION
  ANY
}

enum CourseType {
  TRIENNALE
  MAGISTRALE
  CICLO_UNICO
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  NEW_MESSAGE
  NEW_OPPORTUNITY
  OPPORTUNITY_DEADLINE
  COURSE_DEADLINE
  COURSE_RECOMMENDED
  BADGE_UNLOCKED
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  GROUP_UPDATE
  SYSTEM
  GENERAL
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum VerificationCodeType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GroupMemberRole {
  CREATOR
  MEMBER
}

enum MessageType {
  TEXT
  OPPORTUNITY
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String?
  name         String
  surname      String  @default("")

  phone                  String?
  googleId               String?                @unique
  provider               AuthProvider           @default(LOCAL)
  role                   Role                   @default(USER)
  emailVerified          Boolean                @default(false)
  avatar                 String?
  avatarBgColor          String?
  bio                    String?
  birthDate              DateTime?
  universityId           String?
  university             University?            @relation(fields: [universityId], references: [id])
  courseOfStudy          String?
  yearOfStudy            Int?
  gpa                    GpaRange?
  englishLevel           EnglishLevel?
  willingToRelocate      WillingnessToRelocate?
  region                 String?
  city                   String?
  regionLock             Boolean                @default(false)
  cityLock               Boolean                @default(false)
  profileCompleted       Boolean                @default(false)
  publicProfile          Boolean                @default(true)
  privacySavedOpps       String                 @default("Tutti")
  privacyPathmates       String                 @default("Tutti")
  messagePrivacy         String                 @default("Pathmates")
  privacySkills          String                 @default("Tutti")
  privacyUniversity      String                 @default("Tutti")
  skills                 Json                   @default("{\"core\":null,\"side\":[],\"promptShownAt\":null,\"promptDismissedAt\":null,\"definedAt\":null,\"lastUpdatedAt\":null}")
  passwordResetToken     String?
  passwordResetExpiry    DateTime?
  tosConsentAt           DateTime?
  privacyConsentAt       DateTime?
  marketingConsent       Boolean                @default(false)
  oneSignalPlayerId      String?
  oneSignalEmailPlayerId String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  profile                UserProfile?
  sentMessages           PathMatesMessage[]          @relation("SentMessages")
  receivedMessages       PathMatesMessage[]          @relation("ReceivedMessages")
  createdGroups          PathMatesGroup[]            @relation("GroupCreator")
  groupMemberships       GroupMember[]
  notifications          Notification[]
  sentFriendRequests     FriendRequest[]             @relation("FriendRequestFrom")
  receivedFriendRequests FriendRequest[]             @relation("FriendRequestTo")
  posts                  Post[]
  postLikes              PostLike[]
  postComments           PostComment[]
  postReports            PostReport[]
  commentReports         CommentReport[]
  userReports            UserReport[]                @relation("UserReportReporter")
  reportedBy             UserReport[]                @relation("UserReportTarget")
  savedOpportunities     Opportunity[]               @relation("SavedOpportunities")
  savedCourses           Course[]                    @relation("SavedCourses")
  notificationPreference NotificationPreference?
  pushSubscriptions      PushSubscription[]
  badges                 UserBadge[]
  tracking               UserTracking[]
  verificationCodes      VerificationCode[]
  interactions           UserInteraction[]
  emailLogs              EmailLog[]
  embedding              Unsupported("vector(384)")?

  @@index([universityId])
  @@index([googleId])
  @@index([emailVerified])
  @@index([role])
}

model UserProfile {
  id                  String    @id @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryInterest     String?
  naturalActivity     String?
  freeTimeActivity    String?
  problemSolvingStyle String?
  riskTolerance       String?
  coreValue           String?
  careerVision        String?
  professionalGoal    String?
  passions            String[]
  languages           Json      @default("[]")
  clusterTag          String?
  completedAt         DateTime?
}

model Opportunity {
  id                   String                      @id @default(uuid())
  title                String
  description          String
  titleIt              String? // Italian translation (DeepL); null = not yet translated
  descriptionIt        String? // Italian translation (DeepL); null = not yet translated
  about                String?
  url                  String?
  type                 OpportunityType
  universityId         String?
  university           University?                 @relation(fields: [universityId], references: [id])
  company              String?
  location             String?
  isRemote             Boolean                     @default(false)
  isAbroad             Boolean                     @default(false)
  requiredEnglishLevel EnglishLevel?
  minGpa               GpaRange?
  requiredSkills       String?
  recommendedSkills    String?
  tags                 String[]
  deadline             DateTime?
  postedAt             DateTime                    @default(now())
  expiresAt            DateTime?
  savedBy              User[]                      @relation("SavedOpportunities")
  sharedInMessages     PathMatesMessage[]
  source               String? // e.g. "EURES", "Stage4eu" — CC BY 4.0 attribution
  sourceId             String? // e.g. "eures-12345" — null = manual/seed
  lastSyncedAt         DateTime? // last time this record was refreshed by import
  dedupKey             String? // normalized hash of title+company/organizer — used to skip cross-source duplicates
  embedding            Unsupported("vector(384)")?

  // --- Time / duration (events, summer school, hackathons) ---
  startDate    DateTime?
  endDate      DateTime?
  durationDays Int?

  // --- Format + location detail ---
  format  OpportunityFormat?
  city    String?
  country String? // ISO-3166-1 alpha-2 (e.g. "IT", "DE")
  region  String? // Italian region (e.g. "Puglia", "Lombardia"); null if country != IT

  // --- Schwartz personality cluster classification ---
  clusterScores  Json? // { Analista: 0-1, Creativo: 0-1, Leader: 0-1, Imprenditore: 0-1, Sociale: 0-1, Explorer: 0-1 }
  clusterPrimary String? // denormalized top cluster for fast queries

  // --- Cost / compensation ---
  cost               Int? // EUR; 0 = free, null = unknown
  hasScholarship     Boolean @default(false)
  scholarshipDetails String?
  stipend            Int? // EUR/month offered to participant

  // --- Structured prerequisites ---
  eligibleFields    FieldOfStudy[] @default([]) // empty = any field
  minYearOfStudy    Int?
  maxYearOfStudy    Int?
  requiredLanguages Json           @default("[]") // [{lang:"en",level:"B2"}]

  // --- Provenance ---
  organizer String? // for non-company events: "TEDxMilano", "IFMSA Italy"
  verified  Boolean @default(false) // manually curated/verified

  // --- AI-extracted structured content ---
  structuredContent    Json? // {opportunityDescription, companyDescription, tasks}
  extractedSkills      String[] @default([]) // AI-extracted, up to 5 real skill names
  contextualizedSkills String[] @default([]) // AI-generated contextualized descriptions (TIROCINIO only)

  // --- URL health ---
  urlStatus       String?   @default("UNCHECKED") // UNCHECKED | ACTIVE | BROKEN
  urlCheckedAt    DateTime?
  urlBrokenStreak Int       @default(0) // consecutive 404/410 checks; mark BROKEN only at >=3

  @@index([universityId])
  @@index([type])
  @@index([deadline])
  @@index([sourceId])
  @@index([lastSyncedAt])
  @@index([dedupKey])
  @@index([startDate])
  @@index([format])
  @@index([country])
  @@index([region])
  @@index([clusterPrimary])
  @@index([type, deadline])
  @@index([type, startDate])
}

model University {
  id            String        @id @default(uuid())
  name          String        @unique
  shortName     String?
  city          String
  country       String        @default("Italia")
  logoUrl       String?
  imageUrl      String?
  description   String?
  websiteUrl    String?
  alumniCount   Int           @default(0)
  avgRating     Float         @default(0)
  isActive      Boolean       @default(true)
  sourceId      String? // e.g. "mur-00001" — null = manual/seed
  lastSyncedAt  DateTime?
  users         User[]
  courses       Course[]
  opportunities Opportunity[]

  @@index([sourceId])
}

model Course {
  id                         String                      @id @default(uuid())
  universityId               String
  university                 University                  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name                       String
  type                       CourseType
  field                      String?
  employmentRate             Float?
  avgSalaryAfterGraduation   Int?
  internshipsAvailable       Int?
  internationalOpportunities Boolean                     @default(false)
  programDuration            String?
  languageOfInstruction      String?
  tags                       String[]                    @default([])
  savedBy                    User[]                      @relation("SavedCourses")
  isActive                   Boolean                     @default(true)
  sourceId                   String?
  lastSyncedAt               DateTime?
  embedding                  Unsupported("vector(384)")?

  @@index([sourceId])
}

model PathMatesMessage {
  id            String          @id @default(uuid())
  senderId      String
  sender        User            @relation("SentMessages", fields: [senderId], references: [id])
  receiverId    String?
  receiver      User?           @relation("ReceivedMessages", fields: [receiverId], references: [id])
  groupId       String?
  group         PathMatesGroup? @relation(fields: [groupId], references: [id])
  content       String
  images        String[]        @default([])
  type          MessageType     @default(TEXT)
  opportunityId String?
  opportunity   Opportunity?    @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  sentAt        DateTime        @default(now())
  readAt        DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([groupId])
  @@index([senderId, receiverId])
  @@index([sentAt])
}

model PathMatesGroup {
  id          String             @id @default(uuid())
  name        String
  description String?
  image       String?
  createdById String
  createdBy   User               @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  messages    PathMatesMessage[]
  createdAt   DateTime           @default(now())
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String
  group    PathMatesGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  content   String
  isRead    Boolean          @default(false)
  linkTo    String?
  icon      String?
  data      Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model FriendRequest {
  id         String              @id @default(uuid())
  fromUserId String
  fromUser   User                @relation("FriendRequestFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User                @relation("FriendRequestTo", fields: [toUserId], references: [id])
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}

model Post {
  id          String        @id @default(uuid())
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  images      String[]      @default([])
  autoFlagged Boolean       @default(false)
  createdAt   DateTime      @default(now())
  likes       PostLike[]
  comments    PostComment[]
  reports     PostReport[]

  @@index([authorId])
  @@index([createdAt])
  @@index([autoFlagged])
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model PostComment {
  id          String          @id @default(uuid())
  postId      String
  post        Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content     String
  autoFlagged Boolean         @default(false)
  createdAt   DateTime        @default(now())
  reports     CommentReport[]

  @@index([postId])
}

model PostReport {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model CommentReport {
  id        String      @id @default(uuid())
  commentId String
  comment   PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  createdAt DateTime    @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
}

model UserReport {
  id           String   @id @default(uuid())
  targetUserId String
  targetUser   User     @relation("UserReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User     @relation("UserReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String
  createdAt    DateTime @default(now())

  @@unique([targetUserId, reporterId])
  @@index([targetUserId])
}

model NotificationPreference {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled   Boolean @default(true)
  networking    Boolean @default(true)
  opportunities Boolean @default(true)
  universities  Boolean @default(true)
  social        Boolean @default(true)
  postLikes     Boolean @default(false)
  chat          Boolean @default(true)
  achievements  Boolean @default(true)
  system        Boolean @default(true)
  emailDigest   Boolean @default(true)
  emailAlerts   Boolean @default(true)
  emailSpot     Boolean @default(true)
  emailDaily    Boolean @default(true)
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model UserBadge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId    String
  progress   Int       @default(0)
  unlockedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, badgeId])
  @@index([userId])
}

model UserTracking {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

model ImportLog {
  id         String    @id @default(uuid())
  source     String // mur, eures, almalaurea, istat
  type       String // universities, courses, opportunities, stats
  status     String // success, partial, failed
  count      Int       @default(0)
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  metadata   Json?

  @@index([source, type])
  @@index([startedAt])
}

model VerificationCode {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      VerificationCodeType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, type])
  @@index([code, type])
}

model EmailLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // "weekly_digest" | "expiring_alert"
  sentAt     DateTime @default(now())
  weekNumber Int?
  year       Int?

  @@index([userId, type, weekNumber, year])
  @@index([userId, type, sentAt])
}

model UserInteraction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String // "opportunity" | "course" | "post" | "user"
  targetId   String
  action     String // "view" | "click" | "save" | "unsave" | "apply" | "like" | "comment" | "friend_request"
  weight     Float    @default(1.0)
  createdAt  DateTime @default(now())

  @@index([userId, targetType])
  @@index([targetId, targetType])
  @@index([userId, targetType, action])
}

model CompanyWatchlist {
  id         String @id @default(cuid())
  name       String
  careersUrl String @unique
  sector     String
  tier       String // "large" | "medium"

  // --- Universal source registry (import expansion) ---
  domain          String? // normalized apex domain, discovery/dedup key (e.g. "eni.com")
  atsType         String? // greenhouse|lever|ashby|workable|smartrecruiters|personio|teamtailor|recruitee|workday|custom-static|custom-js|unknown
  atsToken        String? // board token/identifier when an ATS is detected (feeds the ATS factory)
  scrapeTier      String? // "A" (ATS API) | "B" (static+LLM) | "C" (headless+LLM)
  discoverySource String? // e.g. "ats-index:greenhouse", "registry:opencorporates", "search", "manual"
  country         String? @default("IT") // ISO-3166-1 alpha-2

  // --- Change-detection (skip re-scrape/LLM when page unchanged) ---
  contentHash   String? // hash of last extracted <main> content
  contentHashAt DateTime?

  // --- Health / auto-disable ---
  lastScrapeStatus    String? // "ok" | "unchanged" | "error"
  consecutiveFailures Int     @default(0)

  robotsAllowed   Boolean?
  robotsCheckedAt DateTime?

  tosAllowed      Boolean?
  tosAnalyzedAt   DateTime?
  tosNotes        String?
  tosPageNotFound Boolean   @default(false)

  lastSyncedAt DateTime?
  isActive     Boolean   @default(true)
  addedBy      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([tosAllowed])
  @@index([atsType])
  @@index([scrapeTier])
  @@index([domain])
}

/// DB-backed scrape queue for tier B/C career-page scraping at scale.
/// Tier A (ATS APIs) are batch-run per-platform by the ATS factory, not queued.
model ScrapeJob {
  id          String    @id @default(cuid())
  companyId   String // CompanyWatchlist.id
  tier        String // "B" | "C"
  status      String    @default("pending") // pending | running | done | failed
  priority    Int       @default(0) // higher runs first
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now()) // backoff / per-domain rate-limit gate
  lockedAt    DateTime?
  lockedBy    String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter, priority])
  @@index([companyId])
}
